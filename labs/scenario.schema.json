{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.invalid/thesis-labs/scenario.schema.json",
    "title": "Thesis Lab Scenario",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "title",
        "difficulty",
        "duration_minutes",
        "story",
        "documentation",
        "access",
        "lifecycle",
        "checker",
        "build",
        "services",
        "resources",
        "safety"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "difficulty": {
            "type": "string",
            "minLength": 1
        },
        "duration_minutes": {
            "type": "integer",
            "minimum": 1
        },
        "story": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "situation"],
            "properties": {
                "role": {
                    "type": "string",
                    "minLength": 1
                },
                "situation": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "documentation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["student_guide_url"],
            "properties": {
                "student_guide_url": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "access": {
            "type": "object",
            "additionalProperties": false,
            "required": ["primary", "ssh_port_base", "browser_terminal_port_base"],
            "properties": {
                "primary": {
                    "const": "browser_terminal"
                },
                "fallback": {
                    "type": "string"
                },
                "ssh_port_base": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                },
                "app_port_base": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                },
                "browser_terminal_port_base": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                },
                "endpoint_formulas": {
                    "type": "object"
                }
            }
        },
        "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "start_mode",
                "idle_timeout_minutes",
                "max_runtime_minutes",
                "stopped_retention_minutes",
                "auto_destroy_after_minutes",
                "student_actions"
            ],
            "properties": {
                "start_mode": {
                    "type": "string",
                    "minLength": 1
                },
                "idle_timeout_minutes": {
                    "type": ["integer", "null"],
                    "minimum": 1
                },
                "max_runtime_minutes": {
                    "type": "integer",
                    "minimum": 1
                },
                "evaluation_idle_timeout_minutes": {
                    "type": ["integer", "null"],
                    "minimum": 1
                },
                "stopped_retention_minutes": {
                    "type": "integer",
                    "minimum": 0
                },
                "auto_destroy_after_minutes": {
                    "type": "integer",
                    "minimum": 1
                },
                "student_actions": {
                    "type": "array",
                    "items": {
                        "enum": ["start", "stop", "reset", "end", "check"]
                    },
                    "contains": {
                        "const": "start"
                    }
                }
            }
        },
        "checker": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checks", "states"],
            "properties": {
                "states": {
                    "type": "array",
                    "items": {
                        "enum": ["vulnerable", "fixed", "broken"]
                    },
                    "minItems": 3
                },
                "checks": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "exec_in", "run", "states"],
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "exec_in": {
                                "type": "string",
                                "minLength": 1
                            },
                            "run": {
                                "type": "string",
                                "minLength": 1
                            },
                            "states": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["vulnerable", "fixed", "broken"],
                                "properties": {
                                    "vulnerable": { "type": "string", "minLength": 1 },
                                    "fixed": { "type": "string", "minLength": 1 },
                                    "broken": { "type": "string", "minLength": 1 }
                                }
                            }
                        }
                    }
                }
            }
        },
        "build": {
            "type": "object",
            "additionalProperties": false,
            "required": ["images"],
            "properties": {
                "images": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "context", "dockerfile"],
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "context": {
                                "type": "string",
                                "minLength": 1
                            },
                            "dockerfile": {
                                "type": "string",
                                "minLength": 1
                            },
                            "service": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                }
            }
        },
        "services": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": true,
                "required": ["image"],
                "properties": {
                    "image": { "type": "string", "minLength": 1 },
                    "role": { "type": "string" },
                    "internal_ports": { "type": "object" },
                    "published_to_host": { "type": "boolean" }
                }
            },
            "minProperties": 1
        },
        "resources": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": ["cpus", "memory"],
                "properties": {
                    "cpus": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$"
                    },
                    "memory": {
                        "type": "string",
                        "pattern": "^[0-9]+[kKmMgG]?$"
                    }
                }
            },
            "minProperties": 1
        },
        "safety": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "container_runtime_socket_mount",
                "privileged",
                "host_network",
                "publish_vulnerable_service",
                "browser_terminal"
            ],
            "properties": {
                "container_runtime_socket_mount": { "const": false },
                "privileged": { "const": false },
                "host_network": { "const": false },
                "publish_vulnerable_service": { "const": false },
                "browser_terminal": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": [
                        "adapter",
                        "credential_required",
                        "writable",
                        "max_clients",
                        "url_arguments_allowed",
                        "once_requires_supervised_restart"
                    ],
                    "properties": {
                        "adapter": { "const": "ttyd" },
                        "credential_required": { "const": true },
                        "writable": { "const": true },
                        "max_clients": { "type": "integer", "minimum": 1 },
                        "url_arguments_allowed": { "const": false },
                        "once_requires_supervised_restart": { "const": true }
                    }
                }
            }
        }
    }
}
