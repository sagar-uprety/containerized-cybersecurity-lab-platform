{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.invalid/thesis-labs/scenario.schema.json",
    "title": "Thesis Lab Scenario",
    "type": "object",
    "additionalProperties": true,
    "required": [
        "id",
        "title",
        "difficulty",
        "duration_minutes",
        "story",
        "teaching",
        "documentation",
        "access",
        "lifecycle",
        "checker",
        "build",
        "resources",
        "artifacts"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "difficulty": {
            "type": "string",
            "minLength": 1
        },
        "duration_minutes": {
            "type": "integer",
            "minimum": 1
        },
        "story": {
            "type": "object",
            "additionalProperties": true,
            "required": ["role", "situation"],
            "properties": {
                "role": {
                    "type": "string",
                    "minLength": 1
                },
                "situation": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "teaching": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "prerequisites",
                "learning_objectives",
                "misconception_addressed",
                "real_world_reference"
            ],
            "properties": {
                "prerequisites": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    }
                },
                "learning_objectives": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    }
                },
                "misconception_addressed": {
                    "type": "string",
                    "minLength": 1
                },
                "real_world_reference": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "documentation": {
            "type": "object",
            "additionalProperties": true,
            "required": ["student_guide_url"],
            "properties": {
                "student_guide_url": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "access": {
            "type": "object",
            "additionalProperties": true,
            "required": ["primary", "ssh_port_base", "app_port_base", "browser_terminal_port_base"],
            "properties": {
                "primary": {
                    "const": "browser_terminal"
                },
                "ssh_port_base": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                },
                "app_port_base": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                },
                "browser_terminal_port_base": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                }
            }
        },
        "lifecycle": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "start_mode",
                "idle_timeout_minutes",
                "max_runtime_minutes",
                "stopped_retention_minutes",
                "auto_destroy_after_minutes",
                "student_actions"
            ],
            "properties": {
                "start_mode": {
                    "type": "string",
                    "minLength": 1
                },
                "idle_timeout_minutes": {
                    "type": ["integer", "null"],
                    "minimum": 1
                },
                "max_runtime_minutes": {
                    "type": "integer",
                    "minimum": 1
                },
                "evaluation_idle_timeout_minutes": {
                    "type": ["integer", "null"],
                    "minimum": 1
                },
                "stopped_retention_minutes": {
                    "type": "integer",
                    "minimum": 0
                },
                "auto_destroy_after_minutes": {
                    "type": "integer",
                    "minimum": 1
                },
                "student_actions": {
                    "type": "array",
                    "items": {
                        "enum": ["start", "stop", "reset", "end", "check"]
                    },
                    "contains": {
                        "const": "start"
                    }
                }
            }
        },
        "checker": {
            "type": "object",
            "additionalProperties": true,
            "required": ["command", "image_service", "states"],
            "properties": {
                "command": {
                    "type": "string",
                    "minLength": 1
                },
                "image_service": {
                    "type": "string",
                    "minLength": 1
                },
                "states": {
                    "type": "array",
                    "items": {
                        "enum": ["vulnerable", "fixed", "broken"]
                    },
                    "minItems": 3
                }
            }
        },
        "build": {
            "type": "object",
            "additionalProperties": true,
            "required": ["images"],
            "properties": {
                "images": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "context", "dockerfile"],
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "context": {
                                "type": "string",
                                "minLength": 1
                            },
                            "dockerfile": {
                                "type": "string",
                                "minLength": 1
                            },
                            "service": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                }
            }
        },
        "resources": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": ["cpus", "memory"],
                "properties": {
                    "cpus": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$"
                    },
                    "memory": {
                        "type": "string",
                        "pattern": "^[0-9]+[kKmMgG]?$"
                    }
                }
            },
            "minProperties": 1
        },
        "artifacts": {
            "type": "object",
            "additionalProperties": true,
            "required": ["student_guide", "instructor_guide", "solution_notes", "sitrep"],
            "properties": {
                "student_guide": {
                    "type": "string",
                    "minLength": 1
                },
                "instructor_guide": {
                    "type": "string",
                    "minLength": 1
                },
                "solution_notes": {
                    "type": "string",
                    "minLength": 1
                },
                "sitrep": {
                    "type": "string",
                    "minLength": 1
                },
                "fixed_config_example": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}
