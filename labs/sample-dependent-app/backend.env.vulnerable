# PATTERN B - SHARED BACKEND VULNERABLE BASELINE
# The dependent app (records-app) relies on this service. The teaching point of
# Pattern B is that hardening this shared service must not break that app.

# Intentional teaching vulnerability: unauthenticated requests can read records.
ACCESS_CONTROL=disabled

# Dummy lab credential the backend will require once access control is enabled.
# The dependent app must be given this same value to keep working. Never use a
# production or personal credential here.
AUTHORIZED_TOKEN=sample-demo-token
