# PATTERN B - DEPENDENT APP BASELINE
# The app reads records from the backend. In the vulnerable baseline the backend
# needs no credential, so BACKEND_TOKEN is empty. Once a student enables access
# control on the backend, this app must be given the backend's token here, or the
# continuity guardrail (app still serves) will fail.

BACKEND_URL=http://records-backend:8080
BACKEND_TOKEN=
