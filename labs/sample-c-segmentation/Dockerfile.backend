# Pattern C internal backend, reachable only through the proxy.
FROM thesis-labs/lab-service-base:1.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --uid 1000 --create-home --shell /bin/bash proxyadmin

COPY backend.env.baseline /opt/lab/baseline/config.env
COPY seed.txt /opt/lab/seed/seed.txt
COPY setup-backend.sh /opt/lab/hooks/pre-start.sh
COPY internal-backend.py /opt/lab/internal-backend.py
RUN chmod 0755 /opt/lab/hooks/pre-start.sh /opt/lab/internal-backend.py

EXPOSE 8080
