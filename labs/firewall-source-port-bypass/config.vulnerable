*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Intended as a shortcut for recognizing HTTP reply traffic.
# It actually accepts every forwarded TCP packet with source port 80, including
# a new connection sent through the lab's DNAT path to the internal server.
-A FORWARD -p tcp --sport 80 -j ACCEPT

COMMIT
