# Example POC fix. Replace this demo password with the generated lab password
# provided at runtime, then update /lab/demo-app/app-config.env to match.

bind 0.0.0.0
protected-mode yes
port 6379
requirepass change-me-demo-only

dir /data
dbfilename dump.rdb
appendonly yes
appendfilename "appendonly.aof"

save 60 1
loglevel notice
daemonize no
