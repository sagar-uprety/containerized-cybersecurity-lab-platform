# BIND9 named.conf - Vulnerable (Open Recursive Resolver) Configuration
# DO NOT USE IN PRODUCTION - Lab baseline only

options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { none; };

    recursion yes;
    allow-recursion { any; };
    allow-query { any; };
    allow-transfer { none; };

    dnssec-validation no;
};

// The closed lab network resolves only lab.internal through its authoritative host.
zone "lab.internal" {
    type forward;
    forward only;
    forwarders { __DNS_AUTH_IP__; };
};
