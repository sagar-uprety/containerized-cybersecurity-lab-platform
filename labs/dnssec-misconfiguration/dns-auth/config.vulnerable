# BIND9 named.conf - Controlled authoritative server for lab.internal.
# Students do not edit this host; it exists to give the resolver something
# real to forward to and to provide a vantage point outside the trusted
# client network.

options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { none; };

    recursion no;
    allow-query { any; };
    allow-transfer { none; };

    dnssec-validation no;
};

zone "lab.internal" {
    type master;
    file "/etc/bind/zones/db.lab.internal.signed";
};
