# Controlled authoritative server and external vantage point for lab.internal.

options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { none; };

    recursion no;
    allow-query { any; };
    allow-transfer { none; };

    dnssec-validation no;
};

zone "lab.internal" {
    type master;
    file "/etc/bind/zones/db.lab.internal.signed";
};
