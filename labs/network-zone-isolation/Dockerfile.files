FROM thesis-labs/lab-service-base:1.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      samba \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/samba/smb.conf

RUN mkdir -p /srv/samba/shared /var/log/samba \
    && touch /var/log/samba/log.smbd

COPY smb.conf /opt/lab/baseline/smb.conf
COPY internal_memo.txt /srv/samba/shared/internal_memo.txt

EXPOSE 445
