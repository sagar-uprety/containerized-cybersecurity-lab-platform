FROM thesis-labs/lab-service-base:1.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      nginx \
      curl \
    && rm -rf /var/lib/apt/lists/*

COPY nginx.conf /opt/lab/baseline/nginx.conf
COPY seed.html /var/www/html/index.html

RUN mkdir -p /var/www/html /var/log/nginx \
    && touch /var/log/nginx/access.log /var/log/nginx/error.log \
    && chmod 0666 /var/log/nginx/access.log /var/log/nginx/error.log \
    && rm -f /etc/nginx/sites-enabled/default

EXPOSE 80
