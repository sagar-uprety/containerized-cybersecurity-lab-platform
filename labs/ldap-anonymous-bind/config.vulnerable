# Vulnerable ACL: anonymous read access to entire directory
# Applied via ldapmodify to the cn=config frontend database
dn: olcDatabase={-1}frontend,cn=config
changetype: modify
replace: olcAccess
olcAccess: to * by * read

# Replace the backend ACL because it overrides the frontend rule for password hashes.
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: to * by * read
