# Pattern D extends the shared workstation with one lab-specific client.
# Register this image under build.images and services.workstation.image.
# hadolint ignore=DL3007
FROM thesis-labs/workstation-base:latest

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      httpie \
    && rm -rf /var/lib/apt/lists/*
