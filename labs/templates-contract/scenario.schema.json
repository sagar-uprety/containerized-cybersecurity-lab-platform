{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.invalid/thesis-labs/scenario.schema.json",
    "title": "Thesis Lab Scenario",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "title",
        "difficulty",
        "duration_minutes",
        "story",
        "documentation",
        "access",
        "lifecycle",
        "checker",
        "build",
        "services",
        "resources",
        "workstation",
        "containers"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "difficulty": {
            "type": "string",
            "minLength": 1
        },
        "duration_minutes": {
            "type": "integer",
            "minimum": 1
        },
        "story": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "situation"],
            "properties": {
                "role": {
                    "type": "string",
                    "minLength": 1
                },
                "situation": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "documentation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["student_guide_url"],
            "properties": {
                "student_guide_url": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "access": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ssh_port_base", "browser_terminal_port_base"],
            "properties": {
                "ssh_port_base": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                },
                "app_port_base": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                },
                "browser_terminal_port_base": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                }
            }
        },
        "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "idle_timeout_minutes",
                "max_runtime_minutes",
                "retention_after_stop_minutes"
            ],
            "properties": {
                "idle_timeout_minutes": {
                    "type": ["integer", "null"],
                    "minimum": 1
                },
                "max_runtime_minutes": {
                    "type": "integer",
                    "minimum": 1
                },
                "evaluation_idle_timeout_minutes": {
                    "type": ["integer", "null"],
                    "minimum": 1
                },
                "retention_after_stop_minutes": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "checker": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checks", "states"],
            "properties": {
                "states": {
                    "type": "array",
                    "items": {
                        "enum": ["vulnerable", "fixed", "broken"]
                    },
                    "minItems": 3
                },
                "checks": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "exec_in", "run", "states"],
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "exec_in": {
                                "type": "string",
                                "minLength": 1
                            },
                            "run": {
                                "type": "string",
                                "minLength": 1
                            },
                            "states": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["vulnerable", "fixed", "broken"],
                                "properties": {
                                    "vulnerable": { "type": "string", "minLength": 1 },
                                    "fixed": { "type": "string", "minLength": 1 },
                                    "broken": { "type": "string", "minLength": 1 }
                                }
                            }
                        }
                    }
                }
            }
        },
        "build": {
            "type": "object",
            "additionalProperties": false,
            "required": ["images"],
            "properties": {
                "images": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "context", "dockerfile"],
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "context": {
                                "type": "string",
                                "minLength": 1
                            },
                            "dockerfile": {
                                "type": "string",
                                "minLength": 1
                            },
                            "service": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                }
            }
        },
        "services": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["image"],
                "properties": {
                    "image": { "type": "string", "minLength": 1 },
                    "role": { "type": "string" },
                    "internal_ports": { "type": "object" }
                }
            },
            "minProperties": 1
        },
        "resources": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": ["cpus", "memory"],
                "properties": {
                    "cpus": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$"
                    },
                    "memory": {
                        "type": "string",
                        "pattern": "^[0-9]+[kKmMgG]?$"
                    }
                }
            },
            "minProperties": 1
        },
        "workstation": {
            "type": "object",
            "additionalProperties": false,
            "description": "Lab-specific workstation configuration. The full workstation container is auto-generated by labctl from this section plus platform defaults. Only lab-specific pieces are declared here.",
            "properties": {
                "environment": {
                    "type": "object",
                    "additionalProperties": { "type": "string" },
                    "description": "Lab-specific env vars exposed to the student (e.g. service hostnames, ports). Standard vars (LAB_ID, STUDENT_ID, STUDENT_PASSWORD, TTYD_CREDENTIAL, BROWSER_TERMINAL_PORT) are auto-injected."
                },
                "shared_volumes": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "target"],
                        "properties": {
                            "name": { "type": "string", "minLength": 1 },
                            "target": { "type": "string", "minLength": 1 }
                        }
                    },
                    "description": "Config volumes shared between workstation and service containers. Student can edit these at /lab/<target>."
                },
                "depends_on": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Service hostnames the workstation depends on (DNS names from containers[].hostname)."
                },
                "cap_add": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Extra Linux capabilities. NET_RAW is common for labs needing nmap."
                }
            }
        },
        "containers": {
            "type": "array",
            "minItems": 1,
            "description": "Container topology for this lab. Values prefixed with $platform. are resolved at runtime by labctl.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["service", "hostname"],
                "properties": {
                    "service": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Must match a key in services:. Used to resolve the image."
                    },
                    "hostname": {
                        "type": "string",
                        "minLength": 1
                    },
                    "init": {
                        "type": "boolean"
                    },
                    "restart": {
                        "type": "string"
                    },
                    "sysctls": {
                        "type": "object",
                        "additionalProperties": { "type": "string" }
                    },
                    "environment": {
                        "type": "object",
                        "additionalProperties": { "type": "string" },
                        "description": "String values may use $platform.<var> tokens, resolved at runtime."
                    },
                    "ports": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["host_port", "container_port"],
                            "properties": {
                                "host_ip": { "type": "string" },
                                "host_port": { "type": "string" },
                                "container_port": { "type": "integer" }
                            }
                        }
                    },
                    "expose": {
                        "type": "array",
                        "items": { "type": "integer" }
                    },
                    "volumes": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "oneOf": [
                                {
                                    "additionalProperties": false,
                                    "required": ["name", "target"],
                                    "properties": {
                                        "name": {
                                            "type": "string",
                                            "minLength": 1,
                                            "description": "Logical volume name (no runtime prefix). labctl prepends runtime_project_ automatically."
                                        },
                                        "target": { "type": "string", "minLength": 1 }
                                    }
                                },
                                {
                                    "additionalProperties": false,
                                    "required": ["host_path", "target"],
                                    "properties": {
                                        "host_path": {
                                            "type": "string",
                                            "minLength": 1,
                                            "description": "Bind-mount a host path. $platform.lab_source_root and $platform.lab_id are resolved."
                                        },
                                        "target": { "type": "string", "minLength": 1 }
                                    }
                                }
                            ]
                        }
                    },
                    "network_aliases": {
                        "type": "array",
                        "items": { "type": "string" }
                    },
                    "depends_on": {
                        "type": "array",
                        "items": { "type": "string" }
                    },
                    "healthcheck": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["command"],
                        "properties": {
                            "command": {
                                "oneOf": [
                                    { "type": "string" },
                                    { "type": "array", "items": { "type": "string" } }
                                ]
                            },
                            "interval": { "type": "string" },
                            "timeout": { "type": "string" },
                            "retries": { "type": "integer" },
                            "start_period": { "type": "string" }
                        }
                    },
                    "security": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "privileged": { "type": "boolean" },
                            "host_network": { "type": "boolean" },
                            "cap_add": {
                                "type": "array",
                                "items": { "type": "string" }
                            },
                            "cap_drop": {
                                "type": "array",
                                "items": { "type": "string" },
                                "description": "Capabilities to drop. Use [ALL] then cap_add only what is needed."
                            }
                        }
                    },
                    "user": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Run container as this user:group or uid:gid. Overrides the image USER instruction."
                    },
                    "read_only": {
                        "type": "boolean",
                        "description": "Mount the container root filesystem read-only. Writable paths must be volumes."
                    }
                }
            }
        }
    }
}
