#!/usr/bin/env python3
import os
import re
import sys

ALLOWED_VERBS = {"start", "stop", "reset", "destroy", "check", "status"}
LAB_ID = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
STUDENT_ID = re.compile(r"^student[0-9]{2,4}$")
FORBIDDEN = set('/. \t\r\n"\'`$|&;<>\\(){}[]*!?')

SCENARIO_REGISTRY = "{{ lab_runtime_scenario_registry }}"
LABCTL = "{{ thesis_labctl_path }}"


def fail(message):
    print(f"labctl-ssh-wrapper: {message}", file=sys.stderr)
    sys.exit(1)


def strict_token(value, pattern, label):
    if not value or any(ch in FORBIDDEN for ch in value):
        fail(f"invalid {label}")
    if not pattern.match(value):
        fail(f"invalid {label}")


def read_scenarios():
    try:
        with open(SCENARIO_REGISTRY, "r", encoding="utf-8") as handle:
            return {line.strip() for line in handle if line.strip() and not line.startswith("#")}
    except FileNotFoundError:
        return set()


command = os.environ.get("SSH_ORIGINAL_COMMAND", "")
parts = command.split()

# system-status is a distinct, argument-free, read-only verb (host CPU/memory
# and running-lab count for the admin usage dashboard) -- no lab_id/student_id,
# no destructive capability, so it is handled before the 4-part verb parsing.
if len(parts) == 2 and parts[0] == "labctl" and parts[1] == "system-status":
    os.execv("/usr/bin/sudo", ["sudo", "-n", LABCTL, "system-status"])

if len(parts) != 4 or parts[0] != "labctl":
    fail("expected: labctl <verb> <lab_id> <student_id>")

_, verb, lab_id, student_id = parts

if verb not in ALLOWED_VERBS:
    fail("verb is not allowed")

strict_token(lab_id, LAB_ID, "lab_id")
strict_token(student_id, STUDENT_ID, "student_id")

if lab_id not in read_scenarios():
    fail("unknown lab_id")

# that DB, so the boundary here is the strict student-id regex above. We do not
# consult a static student allowlist - portal-created students are not in one.
#
# stdin is intentionally NOT consumed here: it carries the lab password the
# portal injects (Decision B) and is inherited by sudo -> labctl.
os.execv("/usr/bin/sudo", ["sudo", "-n", LABCTL, verb, lab_id, student_id])
