#!/usr/bin/env python3
import sys
from pathlib import Path


LOCAL_PACKAGE_ROOT = Path(__file__).resolve().parent
INSTALLED_PACKAGE_ROOT = Path("/usr/local/lib/thesis-labs")

for package_root in (LOCAL_PACKAGE_ROOT, INSTALLED_PACKAGE_ROOT):
    if (package_root / "labctl_core").exists():
        sys.path.insert(0, str(package_root))

from labctl_core.cli import main


if __name__ == "__main__":
    main()
